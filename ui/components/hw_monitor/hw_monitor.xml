<component>
	<previews>
		<preview width="360" height="184" />
	</previews>

	<api>
		<prop name="cpu_usage" type="subject" default="usage1" />
		<prop name="gpu_usage" type="subject" default="usage2" />
		<prop name="cpu_temp" type="subject" default="temp1" />
		<prop name="gpu_temp" type="subject" default="temp2" />
	</api>

	<styles>
		<style name="style_base" width="360" height="184" pad_all="4" />
		<style name="metric_column" height="100%" flex_grow="1" pad_right="6" />

		<style name="label" text_font="orbitron_semibold_48" width="100%" text_align="center" margin_top="-8" />

		<style name="usage_row" width="100%" text_align="right" margin_top="-16" />
		<style name="usage_value" text_font="orbitron_black_74" />
		<style name="usage_symbol" text_font="orbitron_bold_46" />

		<style name="temp_row" width="100%" text_align="right" margin_top="-20" />
		<style name="temp_value" text_font="orbitron_black_64" />
		<style name="temp_symbol" text_font="orbitron_bold_40" />
	</styles>

	<view style_pad_row="2">
		<remove_style_all />
		<style name="style_base" />

		<row width="100%" height="100%">
			<column>
				<style name="metric_column" />
				<lv_label text="CPU">
					<style name="label" />
				</lv_label>
				<lv_spangroup>
					<style name="usage_row" />
					<lv_spangroup-span bind_text="$cpu_usage" style="usage_value" />
					<lv_spangroup-span text="%" style="usage_symbol" />
				</lv_spangroup>
				<lv_spangroup>
					<style name="temp_row" />
					<lv_spangroup-span bind_text="$cpu_temp" style="temp_value" />
					<lv_spangroup-span text="°C" style="temp_symbol" />
				</lv_spangroup>
			</column>
			<div height="100%" width="2" style_bg_color="#black" style_bg_opa="100%" />
			<column>
				<style name="metric_column" />
				<lv_label text="GPU">
					<style name="label" />
				</lv_label>
				<lv_spangroup>
					<style name="usage_row" />
					<lv_spangroup-span bind_text="$gpu_usage" style="usage_value" />
					<lv_spangroup-span text="%" style="usage_symbol" />
				</lv_spangroup>
				<lv_spangroup>
					<style name="temp_row" />
					<lv_spangroup-span bind_text="$gpu_temp" style="temp_value" />
					<lv_spangroup-span text="°C" style="temp_symbol" />
				</lv_spangroup>
			</column>
		</row>
	</view>
</component>
